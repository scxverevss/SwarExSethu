# SwarExSethu — Environment Configuration
# ---------------------------------------------------------------
# ZERO-KEY BOOT: All AI keys are optional. The app runs fully out of
# the box using a deterministic local engine + Faster-Whisper ASR +
# edge-tts TTS (no API keys required).
# Uncomment/set any key below to upgrade to live cloud AI models.
# Automatic provider failover: Gemini -> OpenAI -> Claude -> Ollama -> Deterministic Local

# Database (default: async SQLite persisted to Docker volume /data)
# Override with DATABASE_URL=mysql+aiomysql://user:pass@host:3306/db for MySQL
DATABASE_URL=sqlite+aiosqlite:////data/app.db
DATA_DIR=/data

# Local ASR (Faster-Whisper, zero-key, downloads model on first use)
WHISPER_MODEL=tiny
ASR_PROVIDER=auto   # faster-whisper | cloud | auto

# TTS (edge-tts is free and needs no API key)
TTS_PROVIDER=edge-tts  # edge-tts | cloud | auto

# Live AI provider keys (optional — any one enables LLM-powered upgrade)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# App
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000